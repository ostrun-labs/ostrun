<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Let the installed tool run on a newer .NET runtime when 8 isn't present. -->
    <RollForward>Major</RollForward>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ostrun</ToolCommandName>
    <PackageId>Ostrun.Cli</PackageId>
    <Version>0.1.0</Version>
    <Authors>ostrun-labs</Authors>
    <Description>Generate a microservice backend from services in the Ostrun catalog.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Keep gateway/.dockerignore in the package; NuGet drops dotfiles by default. -->
    <NoDefaultExcludes>true</NoDefaultExcludes>
  </PropertyGroup>

  <!-- The gateway skeleton and the catalog ship inside the tool, so it runs without a clone of this repo. -->
  <ItemGroup>
    <None Include="..\catalog.json" Link="catalog.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\gateway\*" Exclude="..\gateway\routes.generated.json" Link="gateway\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\gateway\Properties\*" Link="gateway\Properties\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
