{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ostrun.dev/contracts/ostrun/auth/UserRegistered.v1.json",
  "title": "Ostrun.Auth.UserRegistered",
  "version": 1,
  "description": "Published by the Auth service when a user account is created.",
  "type": "object",
  "additionalProperties": false,
  "required": ["userId", "email", "registeredAt"],
  "properties": {
    "userId": {
      "type": "string",
      "format": "uuid",
      "description": "Id of the created account."
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email address given at registration."
    },
    "registeredAt": {
      "type": "string",
      "format": "date-time",
      "description": "UTC timestamp of the account creation."
    }
  }
}
