{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ostrun.dev/contracts/ostrun/auth/UserLoggedIn.v1.json",
  "title": "Ostrun.Auth.UserLoggedIn",
  "version": 1,
  "description": "Published by the Auth service on every successful login.",
  "type": "object",
  "additionalProperties": false,
  "required": ["userId", "email", "loggedInAt"],
  "properties": {
    "userId": {
      "type": "string",
      "format": "uuid",
      "description": "Id of the account that logged in."
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email address of the account that logged in."
    },
    "loggedInAt": {
      "type": "string",
      "format": "date-time",
      "description": "UTC timestamp of the login."
    }
  }
}
