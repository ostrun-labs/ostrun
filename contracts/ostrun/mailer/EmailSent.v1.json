{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ostrun.dev/contracts/ostrun/mailer/EmailSent.v1.json",
  "title": "Ostrun.Mailer.EmailSent",
  "version": 1,
  "description": "Published by the Mailer service after it sends, or tries to send, an email triggered by an upstream event.",
  "type": "object",
  "additionalProperties": false,
  "required": ["userId", "email", "sourceEvent", "sentAtUtc"],
  "properties": {
    "userId": {
      "type": "string",
      "format": "uuid",
      "description": "Id of the recipient user."
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Recipient email address."
    },
    "sourceEvent": {
      "type": "string",
      "description": "Full name of the upstream event that triggered this email (e.g. Ostrun.Auth.UserRegistered)."
    },
    "sentAtUtc": {
      "type": "string",
      "format": "date-time",
      "description": "UTC timestamp of the send."
    }
  }
}
